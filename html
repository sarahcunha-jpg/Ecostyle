    },
    {
        id: 4,
        nome: 'Jeans Sustentável EcoStyle',
        categoria: 'jeans',
        material: 'jeans-reciclado',
        preco: 179.90,
        tamanhos: ['P', 'M', 'G'],
        cores: ['Azul Médio', 'Azul Escuro'],
        impacto: '-80% de água na produção',
        selo: '💧 -80%',
        descricao: 'Corte contemporâneo. Jeans reciclado com lavagem ecológica sem química nociva.',
        imagem: 'linear-gradient(135deg, #4682B4, #2F4F4F)',
        codigo: 'ECO-1004'
    }
];

// ============ ESTADO ============
let carrinho = [];
let paginaAtual = 'home';
let produtoSelecionado = null;

// ============ NAVEGAÇÃO ============
function navegar(pagina) {
    // Esconde todas as páginas
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    // Mostra a página solicitada
    const paginaEl = document.getElementById('pagina-' + pagina);
    if (paginaEl) {
        paginaEl.classList.add('active');
        paginaAtual = pagina;
        // Ações específicas
        if (pagina === 'loja') {
            renderizarLoja();
        } else if (pagina === 'home') {
            renderizarDestaques();
        } else if (pagina === 'carrinho') {
            renderizarCarrinho();
        }
        window.scrollTo(0, 0);
    }
}

// ============ RENDERIZAÇÃO HOME ============
function renderizarDestaques() {
    const grid = document.getElementById('destaques-grid');
    grid.innerHTML = '';
    // Mostra 3 produtos aleatórios ou os 4 primeiros
    produtos.slice(0, 4).forEach(prod => {
        grid.appendChild(criarCardProduto(prod));
    });
}

function criarCardProduto(prod) {
    const card = document.createElement('div');
    card.className = 'card-produto';
    card.onclick = () => abrirProduto(prod.id);
    card.innerHTML = `
        <div class="card-imagem" style="background-image: ${prod.imagem};"></div>
        <span class="badge-sustentavel">${prod.selo}</span>
        <div class="card-info">
            <h3>${prod.nome}</h3>
            <p class="card-preco">R$ ${prod.preco.toFixed(2)}</p>
        </div>
    `;
    return card;
}

// ============ LOJA / FILTROS ============
function renderizarLoja() {
    aplicarFiltros();
}

function aplicarFiltros() {
    const filtroCategoria = document.getElementById('filtro-categoria').value;
    const filtroMaterial = document.getElementById('filtro-material').value;
    const filtroTamanho = document.getElementById('filtro-tamanho').value;
    const filtroPreco = document.getElementById('filtro-preco').value;
    const termoBusca = document.querySelector('.search-bar input').value.toLowerCase();

    const produtosFiltrados = produtos.filter(prod => {
        // Categoria
        if (filtroCategoria !== 'todos' && prod.categoria !== filtroCategoria) return false;
        // Material
        if (filtroMaterial !== 'todos' && prod.material !== filtroMaterial) return false;
        // Tamanho (verifica se o produto tem o tamanho selecionado)
        if (filtroTamanho !== 'todos' && !prod.tamanhos.includes(filtroTamanho)) return false;
        // Preço
        if (filtroPreco !== 'todos') {
            const [min, max] = filtroPreco.split('-').map(Number);
            if (filtroPreco === '300+') {
                if (prod.preco < 300) return false;
            } else {
                if (prod.preco < min || prod.preco > max) return false;
            }
        }
        // Busca
        if (termoBusca && !prod.nome.toLowerCase().includes(termoBusca)) return false;
        return true;
    });

    const grid = document.getElementById('loja-grid');
    grid.innerHTML = '';
    if (produtosFiltrados.length === 0) {
        grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;">Nenhum produto encontrado.</p>';
        return;
    }
    produtosFiltrados.forEach(prod => {
        grid.appendChild(criarCardProduto(prod));
    });
}

function filtrarProdutos(termo) {
    if (paginaAtual === 'loja') {
        aplicarFiltros();
    }
}

// ============ PÁGINA DE PRODUTO ============
function abrirProduto(id) {
    const prod = produtos.find(p => p.id === id);
    if (!prod) return;
    produtoSelecionado = prod;
    navegar('produto');
    const container = document.getElementById('produto-detalhe-conteudo');
    container.innerHTML = `
        <div class="galeria">
            <div class="imagem-principal" style="background-image: ${prod.imagem};"></div>
            <div class="miniaturas">
                <div class="miniatura ativa" style="background-image: ${prod.imagem};" onclick="trocarImagem(this)"></div>
                <div class="miniatura" style="background-image: linear-gradient(45deg, #ccc, #999);" onclick="trocarImagem(this)"></div>
                <div class="miniatura" style="background-image: linear-gradient(45deg, #ddd, #bbb);" onclick="trocarImagem(this)"></div>
            </div>
        </div>
        <div class="info-produto">
            <h1>${prod.nome}</h1>
            <p>${prod.descricao}</p>
            <p class="preco">R$ ${prod.preco.toFixed(2)}</p>
            <div class="seletores">
                <div>
                    <label>Tamanho</label>
                    <select id="tamanho-selecionado">
                        ${prod.tamanhos.map(t => `<option>${t}</option>`).join('')}
                    </select>
                </div>
                <div>
                    <label>Cor</label>
                    <select id="cor-selecionada">
                        ${prod.cores.map(c => `<option>${c}</option>`).join('')}
                    </select>
                </div>
            </div>
            <button class="btn-primario" onclick="adicionarAoCarrinho(${prod.id})">Adicionar ao Carrinho</button>
            <button class="btn-transparencia" onclick="abrirModalQR(${prod.id})">🔍 Rastrear Impacto Deste Produto</button>
            <hr style="margin:1.5rem 0;">
            <h3>Avaliações dos Clientes</h3>
            <p>⭐⭐⭐⭐⭐ "A qualidade é incrível e saber o impacto positivo faz toda diferença!" - Ana J.</p>
            <p>⭐⭐⭐⭐ "Amei o caimento e o tecido. Super confortável." - Carlos M.</p>
        </div>
    `;
}

function trocarImagem(el) {
    const principal = document.querySelector('.imagem-principal');
    principal.style.backgroundImage = el.style.backgroundImage;
    document.querySelectorAll('.miniatura').forEach(m => m.classList.remove('ativa'));
    el.classList.add('ativa');
}

// ============ MODAL QR CODE ============
function abrirModalQR(prodId) {
    const prod = produtos.find(p => p.id === prodId);
    if (!prod) return;
    const modal = document.getElementById('modal-qr');
    document.getElementById('modal-titulo').textContent = `Rastreabilidade - ${prod.nome}`;
    document.getElementById('modal-corpo').innerHTML = `
        <p><strong>Código da Peça:</strong> ${prod.codigo}</p>
        <div class="metricas">
            <div class="metrica"><strong>💧 Água economizada</strong><br>${prod.impacto}</div>
            <div class="metrica"><strong>🌱 Origem</strong><br>${prod.material === 'algodao' ? 'Algodão orgânico certificado' : prod.material === 'tencel' ? 'Tencel de florestas manejadas' : prod.material === 'jeans-reciclado' ? 'Jeans reciclado pós-consumo' : 'Garrafas PET recicladas'}</div>
            <div class="metrica"><strong>⚡ Energia</strong><br>Economia de 35% vs. produção convencional</div>
            <div class="metrica"><strong>🤝 Ética</strong><br>Produção com certificação de trabalho justo</div>
        </div>
        <p>Este produto foi fabricado em unidades parceiras que seguem rigorosos padrões ambientais e sociais.</p>
    `;
    modal.classList.add('ativo');
}

function fecharModal() {
    document.getElementById('modal-qr').classList.remove('ativo');
}

// Fechar modal clicando fora
document.getElementById('modal-qr').addEventListener('click', function(e) {
    if (e.target === this) fecharModal();
});

// ============ CARRINHO ============
function adicionarAoCarrinho(prodId) {
    const prod = produtos.find(p => p.id === prodId);
    if (!prod) return;
    const itemExistente = carrinho.find(item => item.id === prodId);
    if (itemExistente) {
        itemExistente.quantidade++;
    } else {
        carrinho.push({
            id: prod.id,
            nome: prod.nome,
            preco: prod.preco,
            imagem: prod.imagem,
            impacto: prod.impacto,
            selo: prod.selo,
            quantidade: 1
        });
    }
    atualizarContadorCarrinho();
    alert('Produto adicionado ao carrinho!');
}

function atualizarContadorCarrinho() {
    const total = carrinho.reduce((sum, item) => sum + item.quantidade, 0);
    document.getElementById('contador-carrinho').textContent = total;
}

function renderizarCarrinho() {
    const container = document.getElementById('itens-carrinho');
    container.innerHTML = '';
    if (carrinho.length === 0) {
        container.innerHTML = '<p>Seu carrinho está vazio.</p>';
        document.getElementById('impacto-carrinho').innerHTML = '';
        return;
    }
    carrinho.forEach(item => {
        const div = document.createElement('div');
        div.className = 'item-carrinho';
        div.innerHTML = `
            <div style="width:80px;height:80px;border-radius:8px;background-image:${item.imagem};"></div>
            <div style="flex:1;">
                <strong>${item.nome}</strong>
                <p>Quantidade: ${item.quantidade}</p>
                <p>Preço unitário: R$ ${item.preco.toFixed(2)}</p>
            </div>
            <button class="btn-transparencia" onclick="removerDoCarrinho(${item.id})">Remover</button>
        `;
        container.appendChild(div);
    });

    // Calcula impacto total (simplificado)
    let impactoMsg = '';
    let aguaTotal = 0;
    let petTotal = 0;
    carrinho.forEach(item => {
        if (item.impacto.includes('água')) {
            aguaTotal += 2400 * item.quantidade;
        } else if (item.impacto.includes('PET')) {
            petTotal += 12 * item.quantidade;
        }
    });
    impactoMsg = `🌍 Com este carrinho, você está economizando:`;
    if (aguaTotal > 0) impactoMsg += `<br>💧 ${aguaTotal.toLocaleString()} litros de água`;
    if (petTotal > 0) impactoMsg += `<br>♻️ ${petTotal} garrafas PET recicladas`;
    impactoMsg += '<br>Obrigado por escolher um futuro mais sustentável!';
    document.getElementById('impacto-carrinho').innerHTML = impactoMsg;
}

function removerDoCarrinho(prodId) {
    carrinho = carrinho.filter(item => item.id !== prodId);
    atualizarContadorCarrinho();
    renderizarCarrinho();
}

function finalizarCompra(event) {
    event.preventDefault();
    alert('Pedido realizado com sucesso! Obrigado por escolher EcoStyle. 🌿');
    carrinho = [];
    atualizarContadorCarrinho();
    navegar('home');
}

// ============ TRANSPARÊNCIA (página separada) ============
function verificarCodigo() {
    const codigo = document.getElementById('codigo-transparencia').value.trim();
    const resultado = document.getElementById('resultado-transparencia');
    if (!codigo) {
        resultado.innerHTML = '<p>Por favor, digite um código.</p>';
        return;
    }
    // Simula busca pelo código
    const prod = produtos.find(p => p.codigo === codigo);
    if (prod) {
        resultado.innerHTML = `
            <div class="modal-conteudo" style="position:static;box-shadow:none;border:2px solid var(--verde-folha);">
                <h3>${prod.nome}</h3>
                <p><strong>Impacto:</strong> ${prod.impacto}</p>
                <p><strong>Material:</strong> ${prod.material}</p>
                <p><strong>Processo:</strong> Produção ética com certificação ambiental.</p>
            </div>
        `;
    } else {
        resultado.innerHTML = '<p>Código não encontrado. Tente novamente.</p>';
    }
}

// ============ INICIALIZAÇÃO ============
document.addEventListener('DOMContentLoaded', () => {
    renderizarDestaques();
    renderizarLoja();
    atualizarContadorCarrinho();
});
</script>

