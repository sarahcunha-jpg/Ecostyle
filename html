<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoStyle - Vista o futuro</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --verde-floresta: #0D2C1D;
            --verde-profundo: #071F14;
            --off-white: #FAF8F5;
            --bege-suave: #E8F0EB;
            --verde-folha: #8BB396;
            --verde-destaque: #A8D5B5;
            --texto-claro: #FAF8F5;
            --texto-escuro: #071F14;
            --sombra: 0 4px 12px rgba(0,0,0,0.1);
            --transicao: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--off-white);
            color: var(--texto-escuro);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ============ HEADER ============ */
        header {
            background-color: var(--verde-floresta);
            color: var(--texto-claro);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--sombra);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--bege-suave);
        }

        .logo span {
            color: var(--verde-destaque);
        }

        .menu {
            display: flex;
            gap: 1.5rem;
            list-style: none;
        }

        .menu a {
            color: var(--bege-suave);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transicao);
        }

        .menu a:hover {
            color: var(--verde-destaque);
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 1.2rem;
        }

        .icon-btn {
            background: none;
            border: none;
            color: var(--bege-suave);
            font-size: 1.2rem;
            cursor: pointer;
            position: relative;
            transition: var(--transicao);
        }

        .icon-btn:hover {
            color: var(--verde-destaque);
        }

        .cart-count {
            background-color: var(--verde-destaque);
            color: var(--verde-profundo);
            border-radius: 50%;
            padding: 0.2rem 0.5rem;
            font-size: 0.75rem;
            position: absolute;
            top: -8px;
            right: -8px;
            font-weight: 600;
        }

        .search-bar {
            display: flex;
            align-items: center;
            background-color: var(--bege-suave);
            border-radius: 25px;
            padding: 0.5rem 1rem;
            margin: 0 1rem;
        }

        .search-bar input {
            border: none;
            background: transparent;
            outline: none;
            margin-left: 0.5rem;
            width: 200px;
            color: var(--texto-escuro);
        }

        /* ============ PÁGINAS (SPA) ============ */
        .page {
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ============ HOME ============ */
        .hero-banner {
            background: linear-gradient(135deg, var(--verde-profundo), var(--verde-floresta));
            color: var(--texto-claro);
            padding: 4rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            bottom: -50px;
            left: 0;
            right: 0;
            height: 100px;
            background: var(--off-white);
            transform: skewY(-3deg);
        }

        .hero-banner h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            letter-spacing: 2px;
        }

        .hero-banner p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 2rem;
            color: var(--bege-suave);
        }

        .btn-primario {
            background-color: var(--verde-destaque);
            color: var(--verde-profundo);
            padding: 0.8rem 2rem;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transicao);
            text-decoration: none;
            display: inline-block;
        }

        .btn-primario:hover {
            background-color: var(--verde-folha);
            transform: translateY(-2px);
        }

        .destaques {
            padding: 3rem 2rem;
            background-color: var(--off-white);
        }

        .destaques h2 {
            text-align: center;
            margin-bottom: 2rem;
            color: var(--verde-floresta);
        }

        .produtos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .card-produto {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--sombra);
            transition: var(--transicao);
            cursor: pointer;
            position: relative;
        }

        .card-produto:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .card-imagem {
            height: 250px;
            background-color: var(--bege-suave);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: var(--verde-folha);
            background-size: cover;
            background-position: center;
            transition: var(--transicao);
        }

        .card-info {
            padding: 1rem;
        }

        .card-info h3 {
            margin-bottom: 0.5rem;
            color: var(--verde-floresta);
        }

        .card-preco {
            font-weight: 600;
            color: var(--verde-floresta);
        }

        .badge-sustentavel {
            background-color: var(--verde-folha);
            color: var(--verde-profundo);
            font-size: 0.75rem;
            padding: 0.3rem 0.6rem;
            border-radius: 15px;
            position: absolute;
            top: 10px;
            left: 10px;
            font-weight: 600;
        }

        .proposito {
            background-color: var(--bege-suave);
            padding: 3rem 2rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .proposito-texto {
            flex: 1 1 300px;
            max-width: 500px;
        }

        .proposito-texto h2 {
            color: var(--verde-floresta);
            margin-bottom: 1rem;
        }

        .proposito-imagem {
            flex: 1 1 300px;
            background: linear-gradient(45deg, var(--verde-folha), var(--verde-destaque));
            height: 300px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            color: var(--verde-profundo);
        }

        /* ============ LOJA / LISTAGEM ============ */
        .filtros {
            background-color: var(--bege-suave);
            padding: 1.5rem 2rem;
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
            justify-content: center;
            border-bottom: 2px solid var(--verde-folha);
        }

        .filtros select, .filtros input {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            border: 1px solid var(--verde-folha);
            background: white;
            font-family: inherit;
        }

        /* ============ PÁGINA DE PRODUTO ============ */
        .produto-detalhe {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .galeria {
            flex: 1 1 400px;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .imagem-principal {
            height: 400px;
            background-color: var(--bege-suave);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            background-size: cover;
            background-position: center;
        }

        .miniaturas {
            display: flex;
            gap: 0.5rem;
        }

        .miniatura {
            width: 70px;
            height: 70px;
            border-radius: 8px;
            background-color: var(--bege-suave);
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transicao);
            background-size: cover;
        }

        .miniatura:hover, .miniatura.ativa {
            border-color: var(--verde-folha);
        }

        .info-produto {
            flex: 1 1 400px;
            padding: 1rem;
        }

        .info-produto h1 {
            color: var(--verde-floresta);
            margin-bottom: 0.5rem;
        }

        .info-produto .preco {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--verde-floresta);
            margin: 1rem 0;
        }

        .seletores {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .seletores label {
            font-weight: 500;
            display: block;
            margin-bottom: 0.3rem;
        }

        .seletores select {
            padding: 0.5rem;
            border-radius: 8px;
            border: 1px solid var(--verde-folha);
        }

        .btn-transparencia {
            background: none;
            border: 2px solid var(--verde-folha);
            color: var(--verde-floresta);
            padding: 0.6rem 1.2rem;
            border-radius: 25px;
            cursor: pointer;
            margin: 1rem 0;
            transition: var(--transicao);
            font-weight: 500;
        }

        .btn-transparencia:hover {
            background-color: var(--verde-folha);
            color: white;
        }

        /* Modal QR Code */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .modal-overlay.ativo {
            display: flex;
        }

        .modal-conteudo {
            background: white;
            border-radius: 15px;
            max-width: 500px;
            width: 90%;
            padding: 2rem;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .modal-fechar {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            background: none;
            border: none;
            cursor: pointer;
        }

        .metricas {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .metrica {
            background: var(--bege-suave);
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
        }

        /* ============ CARRINHO ============ */
        .carrinho {
            padding: 2rem;
            max-width: 800px;
            margin: 0 auto;
        }

        .item-carrinho {
            display: flex;
            align-items: center;
            gap: 1rem;
            background: white;
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            box-shadow: var(--sombra);
        }

        .item-carrinho img {
            width: 80px;
            height: 80px;
            background-color: var(--bege-suave);
            border-radius: 8px;
            object-fit: cover;
        }

        .impacto-carrinho {
            background-color: var(--verde-folha);
            color: var(--verde-profundo);
            padding: 1rem;
            border-radius: 10px;
            margin: 1rem 0;
            font-weight: 500;
        }

        .checkout {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: var(--sombra);
        }

        .checkout input, .checkout select {
            width: 100%;
            padding: 0.7rem;
            margin-bottom: 1rem;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        /* ============ TRANSPARÊNCIA ============ */
        .transparencia {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
        }

        .codigo-input {
            display: flex;
            gap: 0.5rem;
            margin: 1rem 0;
        }

        .codigo-input input {
            flex: 1;
            padding: 0.8rem;
            border: 1px solid var(--verde-folha);
            border-radius: 8px;
        }

        /* ============ SOBRE ============ */
        .sobre {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            text-align: center;
        }

        .fundadoras {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .fundadora {
            background: var(--bege-suave);
            padding: 1rem;
            border-radius: 10px;
            width: 150px;
        }

        /* ============ RODAPÉ ============ */
        footer {
            background-color: var(--verde-profundo);
            color: var(--bege-suave);
            text-align: center;
            padding: 2rem;
            margin-top: 2rem;
        }

        /* Responsividade */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 1rem;
            }
            .menu {
                flex-wrap: wrap;
                justify-content: center;
            }
            .hero-banner h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>

<header>
    <div class="logo">Eco<span>Style</span></div>
    <ul class="menu">
        <li><a href="#" onclick="navegar('home')">Home</a></li>
        <li><a href="#" onclick="navegar('loja')">Loja</a></li>
        <li><a href="#" onclick="navegar('transparencia')">Transparência</a></li>
        <li><a href="#" onclick="navegar('sobre')">Sobre</a></li>
    </ul>
    <div class="header-icons">
        <div class="search-bar">
            <span>🔍</span>
            <input type="text" placeholder="Buscar..." oninput="filtrarProdutos(this.value)">
        </div>
        <button class="icon-btn" onclick="navegar('carrinho')">🛒 <span class="cart-count" id="contador-carrinho">0</span></button>
        <button class="icon-btn">👤</button>
    </div>
</header>

<!-- PÁGINA HOME -->
<div class="page active" id="pagina-home">
    <div class="hero-banner">
        <h1>Vista o futuro.<br>Vista EcoStyle.</h1>
        <p>Moda urbana sustentável com transparência total. Cada peça conta uma história de impacto positivo.</p>
        <a href="#" class="btn-primario" onclick="navegar('loja')">Explorar Coleção</a>
    </div>

    <div class="destaques">
        <h2>Lançamentos em Destaque</h2>
        <div class="produtos-grid" id="destaques-grid">
            <!-- Preenchido via JS -->
        </div>
    </div>

    <div class="proposito">
        <div class="proposito-texto">
            <h2>Nosso Propósito</h2>
            <p>Acreditamos que moda e sustentabilidade podem caminhar juntas. Cada peça EcoStyle é produzida com matérias-primas ecológicas e processos éticos, e você pode rastrear todo o impacto positivo através do QR Code exclusivo.</p>
            <button class="btn-transparencia" onclick="navegar('transparencia')">Saiba mais sobre o QR Code</button>
        </div>
        <div class="proposito-imagem">🌱</div>
    </div>
</div>

<!-- PÁGINA LOJA -->
<div class="page" id="pagina-loja">
    <div class="filtros">
        <select id="filtro-categoria" onchange="aplicarFiltros()">
            <option value="todos">Todas as Categorias</option>
            <option value="camiseta">Camisetas Oversized</option>
            <option value="moletom">Moletons</option>
            <option value="calca">Calças Cargo</option>
            <option value="jeans">Jeans Sustentáveis</option>
        </select>
        <select id="filtro-material" onchange="aplicarFiltros()">
            <option value="todos">Todos os Materiais</option>
            <option value="algodao">Algodão Orgânico</option>
            <option value="tencel">Tencel (Lyocell)</option>
            <option value="jeans-reciclado">Jeans Reciclado</option>
            <option value="poliester-reciclado">Poliéster Reciclado</option>
        </select>
        <select id="filtro-tamanho" onchange="aplicarFiltros()">
            <option value="todos">Todos os Tamanhos</option>
            <option value="P">P</option>
            <option value="M">M</option>
            <option value="G">G</option>
            <option value="GG">GG</option>
        </select>
        <select id="filtro-preco" onchange="aplicarFiltros()">
            <option value="todos">Qualquer Preço</option>
            <option value="0-100">Até R$100</option>
            <option value="100-200">R$100 - R$200</option>
            <option value="200-300">R$200 - R$300</option>
            <option value="300+">Acima de R$300</option>
        </select>
    </div>
    <div class="destaques">
        <div class="produtos-grid" id="loja-grid">
            <!-- Preenchido via JS -->
        </div>
    </div>
</div>

<!-- PÁGINA DETALHE DO PRODUTO (dinâmica) -->
<div class="page" id="pagina-produto">
    <div class="produto-detalhe" id="produto-detalhe-conteudo">
        <!-- Preenchido via JS -->
    </div>
</div>

<!-- PÁGINA TRANSPARÊNCIA -->
<div class="page" id="pagina-transparencia">
    <div class="transparencia">
        <h1>Transparência QR Code</h1>
        <p>Digite o código da sua peça (ex: ECO-12345) para ver o impacto ambiental completo.</p>
        <div class="codigo-input">
            <input type="text" id="codigo-transparencia" placeholder="Ex: ECO-12345">
            <button class="btn-primario" onclick="verificarCodigo()">Rastrear</button>
        </div>
        <div id="resultado-transparencia"></div>
        <hr style="margin:2rem 0; border-color:var(--verde-folha);">
        <h3>Como funciona?</h3>
        <p>Cada peça EcoStyle possui uma etiqueta com QR Code exclusivo. Ao escanear, você acessa informações detalhadas sobre a origem da matéria-prima, métricas de economia de água e energia, e o processo produtivo ético.</p>
    </div>
</div>

<!-- PÁGINA SOBRE -->
<div class="page" id="pagina-sobre">
    <div class="sobre">
        <h1>Sobre a EcoStyle</h1>
        <p>Fundada por Wana Luísa, Mariana Souza, Sara Hellen, Rayane Cristina e Yasmim Gabrielly, a EcoStyle nasceu com a missão de revolucionar a moda casual urbana, unindo estilo, conforto e responsabilidade ambiental.</p>
        <h3>Missão</h3>
        <p>Oferecer moda sustentável e acessível, com total transparência sobre o impacto de cada peça.</p>
        <h3>Visão</h3>
        <p>Ser referência em moda consciente para a geração que se preocupa com o futuro do planeta.</p>
        <h3>Valores</h3>
        <p>Sustentabilidade, Transparência, Inovação, Ética e Estilo.</p>
        <div class="fundadoras">
            <div class="fundadora">🌿 Wana Luísa</div>
            <div class="fundadora">🌿 Mariana Souza</div>
            <div class="fundadora">🌿 Sara Hellen</div>
            <div class="fundadora">🌿 Rayane Cristina</div>
            <div class="fundadora">🌿 Yasmim Gabrielly</div>
        </div>
    </div>
</div>

<!-- PÁGINA CARRINHO -->
<div class="page" id="pagina-carrinho">
    <div class="carrinho">
        <h1>Seu Carrinho</h1>
        <div id="itens-carrinho">
            <!-- Preenchido via JS -->
        </div>
        <div class="impacto-carrinho" id="impacto-carrinho">
            <!-- Impacto calculado -->
        </div>
        <div class="checkout">
            <h2>Finalizar Compra</h2>
            <form id="form-checkout" onsubmit="finalizarCompra(event)">
                <input type="text" placeholder="Nome completo" required>
                <input type="email" placeholder="E-mail" required>
                <input type="text" placeholder="Endereço" required>
                <select required>
                    <option value="">Opção de Frete</option>
                    <option value="padrao">Frete Padrão (R$ 15,00)</option>
                    <option value="verde">Frete Verde - bicicleta/elétrico (R$ 10,00)</option>
                </select>
                <select required>
                    <option value="">Forma de Pagamento</option>
                    <option value="pix">Pix</option>
                    <option value="cartao">Cartão de Crédito</option>
                    <option value="carteira">Carteira Digital</option>
                </select>
                <button type="submit" class="btn-primario" style="width:100%;">Concluir Pedido</button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL QR CODE -->
<div class="modal-overlay" id="modal-qr">
    <div class="modal-conteudo">
        <button class="modal-fechar" onclick="fecharModal()">&times;</button>
        <h2 id="modal-titulo">Rastreabilidade do Produto</h2>
        <div id="modal-corpo">
            <!-- Preenchido via JS -->
        </div>
    </div>
</div>

<footer>
    <p>© 2025 EcoStyle - Vista o futuro. Vista EcoStyle. | Sustentabilidade em cada fio.</p>
</footer>

